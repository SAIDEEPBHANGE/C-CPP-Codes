#include<conio.h>
#include<stdio.h>
#include<math.h>
#include<stdlib.h>
void main()
{
	int data[30],tra[30],res[30],r=0,i,j,k,c,m,pos,cnt=0;
	clrscr();
	printf("\n \n \t Transmitter Side ");
	// Input dataSS
	printf("\n\n Enter the length of data : ");
	scanf("%d",&m);
	printf("\n\n Enter the %d data bits : ",m);
	for(i=0;i<m;i++)
		scanf("%d",&data[i]);
			// Finding value of 'r'- check bits
	while(m+r+1>=pow(2,r))
		r++;
	printf("\n\n Number of check bits are : %d",r);
	// Initializing transmitting data
	for(i=1,j=0,k=0;i<=m+r;i++)
		tra[i]=0;
	//Inserting Check bits in data at position
	for(i=1,j=0;i<=m+r;i++){
		if(i==pow(2,j))
			j++;
		else{
			tra[i]=data[cnt];
			cnt++;
		}
	}
	// Printing data after adding check bits
	printf("\n\n After adding check bits : ");
	for(i=1;i<=m+r;i++)
		printf(" %d",tra[i]);
	// Getting values for check bits
	for(i=0;i<r;i++){
		c=0;
		pos=pow(2,i);
		for(j=pos;j<=m+r;j=j+(2*pos))
			for(k=j;k<=m+r&&k<(j+pos);k++)
				c=c^tra[k];
		printf("\n c%d = %d ",i,c);
		tra[pos]=c;
	}
	// Print Transmitted data
	printf("\n\n  Transmitted data : ");
	for(i=1;i<=m+r;i++)
		printf(" %d",tra[i]);
	printf("\n\n Now turn to receiver side ---> ");
	getch();
	clrscr();
	printf("\n\n\t---------- Receiver Side ----------");
	printf("\n\n  Transmitted data : ");
	for(i=1;i<=m+r;i++)
		printf(" %d",tra[i]);
	printf("\n\n Enter received data : ");
	for(i=1;i<=m+r;i++)
		scanf("%d",&res[i]);
	cnt=0;
	for(i=0;i<r;i++){ 
		c=0;
		pos=pow(2,i);
		for(j=pos;j<=m+r;j=j+(2*pos))
			for(k=j;k<=m+r&&k<(j+pos);k++)
				c=c^res[k];
		if(c==1)
		cnt=cnt+pos;
	}
	if(cnt==0){
		printf("\n\nData Received Correctly ! ");
		getch();
		exit(0);
	}
	else
	cnt++;
	printf("\n\n Data Not Received Correctly ! \n");
	cnt--;
	for(i=1;i<=m+r;i++)
	printf("  %d ",tra[i]);
	printf("\n");
	textcolor(RED+BLINK);
	for(i=1;i<=m+r;i++){
	if(cnt==i)
	cprintf("  %d ",res[i]);
	else
	printf("  %d ",res[i]);
	}
	printf("\n\n Error at %d position",cnt);
	getch();
}